# ==============================================================================
# Luminex — Environment Variables Configuration (.env.example)
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file or credentials to Git.
# ==============================================================================

# --- Django Core ---
SECRET_KEY=django-insecure-luminex-dev-key-change-in-production-!!!
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://your-app-name.onrender.com,http://localhost:8000,http://127.0.0.1:8000
DJANGO_SETTINGS_MODULE=luminex.settings.production

# --- Production Database (PostgreSQL) ---
# Provided automatically when creating a PostgreSQL instance on Render
DATABASE_URL=postgresql://luminex_user:your_password@dpg-xxxxxx.render.com/luminex_db
DB_SSL_REQUIRE=True

# --- Persistent Media Storage (AWS S3 / Cloudflare R2 / S3-compatible) ---
# Leave empty for local development (uses local media/ folder).
# In production on Render, ephemeral disks wipe uploaded media on each deploy/restart.
# Configure an S3-compatible bucket to persist product images and banners permanently.
AWS_STORAGE_BUCKET_NAME=your-media-bucket-name
AWS_ACCESS_KEY_ID=your-s3-access-key-id
AWS_SECRET_ACCESS_KEY=your-s3-secret-access-key
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  # Optional for Cloudflare R2 / MinIO
# AWS_S3_CUSTOM_DOMAIN=media.yourdomain.com                          # Optional for CloudFront / custom CDN
# SERVE_MEDIA_LOCAL=False                                            # Optional toggle for serving local media when DEBUG=False

# --- Security Overrides (defaults to True in production) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Email Settings (optional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-specific-password
